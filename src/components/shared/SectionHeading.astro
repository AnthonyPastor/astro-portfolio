---
interface Props {
	title: string;
	subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<h2 class='mb-11 flex flex-wrap items-baseline gap-x-3.5 gap-y-1' data-reveal='1'>
	<span class='text-[clamp(28px,3.6vw,40px)] font-semibold tracking-[-0.03em] text-[var(--fg)]'>
		{title}
	</span>
	{
		subtitle && (
			<span class='text-[13px] text-[var(--text-3)] [font-family:var(--font-mono)]'>
				{subtitle}
			</span>
		)
	}
</h2>
