---
interface Props {
	link: string;
	downloadName?: string;
}
const { link, downloadName } = Astro.props;

// Determinar si es un enlace de descarga
const isDownload = downloadName && (link.endsWith('.pdf') || link.endsWith('.doc') || link.endsWith('.docx') || link.endsWith('.zip'));
---

<a
	href={link}
	{...isDownload ? {} : { target: '_blank', rel: 'noopener noreferrer' }}
	{...downloadName ? { download: downloadName } : {}}
	role='link'
	class='rounded-full border border-white/10 flex justify-center items-center gap-x-2 py-1 lg:py-2 px-2 lg:px-4 bg-white/5 hover:scale-110 hover:bg-white/10 transition text-xs lg:text-base'
>
	<slot />
</a>
