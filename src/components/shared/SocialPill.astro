---
interface Props {
	link: string;
	downloadName?: string;
	variant?: "primary" | "ghost" | "icon";
	ariaLabel?: string;
}
const { link, downloadName, variant = "ghost", ariaLabel } = Astro.props;

const isDownload =
	downloadName &&
	(link.endsWith(".pdf") || link.endsWith(".doc") || link.endsWith(".docx") || link.endsWith(".zip"));

const VARIANTS: Record<string, string> = {
	primary:
		"bg-white text-[var(--bg)] px-[26px] py-[15px] text-[17px] font-semibold hover:-translate-y-1 hover:shadow-[0_14px_40px_-10px_rgba(255,255,255,0.45)]",
	ghost:
		"border border-[var(--border-2)] bg-white/[0.03] px-6 py-[15px] text-[17px] font-medium text-[var(--fg)] backdrop-blur-md hover:-translate-y-1 hover:bg-white/10 hover:border-white/30",
	icon: "border border-[var(--border-2)] bg-white/[0.03] size-[54px] text-[var(--fg)] backdrop-blur-md hover:-translate-y-1 hover:bg-white/10",
};
---

<a
	href={link}
	{...isDownload ? {} : { target: "_blank", rel: "noopener noreferrer" }}
	{...downloadName ? { download: downloadName } : {}}
	role='link'
	aria-label={ariaLabel}
	class={`inline-flex items-center justify-center gap-2.5 rounded-full transition ${VARIANTS[variant]}`}
>
	<slot />
</a>
