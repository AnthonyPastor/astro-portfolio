---
import LinkButton from "@/components/shared/LinkButton.astro";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import GithubIcon from "@/icons/Github.astro";
import LinkIcon from "@/icons/Link.astro";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const PROJECTS = [
	{
		title: "Artesania Uruguay",
		description: i18n.projects.proj_1.description,
		link: "https://artesaniauruguay.uy/",
		image: "/projects/artesanias.webp",
		alt: i18n.projects.alt.artesania,
		tags: ["React.js", "Strapi"],
	},
	{
		title: "Marcelo Coronato Metalurgia",
		description: i18n.projects.proj_2.description,
		link: "https://herreria-coronato-git-dev-anthonypastor.vercel.app/",
		image: "/projects/coronato.webp",
		alt: i18n.projects.alt.coronato,
		tags: ["React.js", "Next.js"],
	},
	{
		title: "Teslo Shop",
		description: i18n.projects.proj_3.description,
		link: "https://teslo-shop-ap.vercel.app/",
		github: "https://github.com/AnthonyPastor/teslo-shop-ap",
		github2: "https://github.com/AnthonyPastor/product-rest-api",
		image: "/projects/teslo-shop.webp",
		alt: i18n.projects.alt.teslo,
		tags: ["React.js", "Next.js", "Nest.js", "Docker"],
	},
];
---

<SectionHeading title={i18n.projects.title} subtitle={i18n.projects.subtitle} />
{
	PROJECTS.map(({ title, description, link, github, github2, image, alt, tags }, index) => (
		<article class='project-card' data-card data-reveal={index + 1}>
			<div class='project-glow' aria-hidden='true' />
			<div class='project-grid'>
				<div class='project-text'>
					<h3 class='text-[clamp(23px,2.6vw,30px)] font-semibold tracking-[-0.025em] text-[var(--fg)]'>{title}</h3>
					<p class='text-[17px] leading-[1.6] text-[var(--text-1)] text-pretty'>{description}</p>
					<ul class='flex flex-wrap gap-2'>
						{tags.map((tag) => (
							<li class='rounded-full border border-[var(--border-1)] bg-white/5 px-3 py-1 text-[12px] text-[var(--text-1)] [font-family:var(--font-mono)]'>
								{tag}
							</li>
						))}
					</ul>
					<footer class='mt-auto pt-2.5 flex flex-wrap items-center gap-2.5'>
						{link && (
							<LinkButton href={link}>
								<LinkIcon class='size-4' />
								{i18n.projects.links.web}
							</LinkButton>
						)}
						{github && (
							<LinkButton href={github}>
								<GithubIcon class='size-4' />
								{i18n.projects.links.code}
							</LinkButton>
						)}
						{github2 && (
							<LinkButton href={github2}>
								{i18n.projects.links.api}
							</LinkButton>
						)}
					</footer>
				</div>
				<div class='project-image-wrap'>
					<img src={image} alt={alt} loading='lazy' class='project-image' data-zoom />
				</div>
			</div>
		</article>
	))
}

<style>
	.project-card {
		position: relative;
		overflow: hidden;
		border-radius: 1.5rem;
		border: 1px solid var(--border-1);
		background: var(--surface-1);
		backdrop-filter: blur(14px);
		margin-bottom: 1.75rem;
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}
	.project-card:last-child {
		margin-bottom: 0;
	}
	.project-card.is-active {
		border-color: var(--border-2);
		box-shadow: 0 0 40px -10px oklch(0.85 0.13 195 / 0.25);
	}
	.project-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.3s ease;
		background: radial-gradient(
			340px circle at var(--x, 50%) var(--y, 50%),
			oklch(0.85 0.13 195 / 0.15),
			transparent 70%
		);
	}
	.project-card.is-active .project-glow {
		opacity: 1;
	}
	.project-grid {
		position: relative;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
	}
	.project-text {
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.project-image-wrap {
		position: relative;
		overflow: hidden;
		min-height: 280px;
	}
	.project-image-wrap::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(90deg, var(--surface-1) 0%, transparent 40%);
	}
	.project-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left top;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.project-card.is-active .project-image {
		transform: scale(1.06);
	}
</style>
