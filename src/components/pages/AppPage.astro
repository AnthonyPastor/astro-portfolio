---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/shared/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import Profile from "@/components/Profile.astro";
import Stack from "@/components/Stack.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import AboutMe from "@/components/AboutMe.astro";
import Contact from "@/components/Contact.astro";
---

<Layout>
	<main class='px-6'>
		<SectionContainer id='hero' class='pt-28 md:pt-32 lg:pt-36 pb-10'>
			<Hero />
			<slot />
		</SectionContainer>

		<SectionContainer class='pt-16 pb-28'>
			<Profile />
		</SectionContainer>

		<SectionContainer class='pb-28'>
			<Stack />
		</SectionContainer>

		<SectionContainer id='experience' class='pb-28'>
			<Experience />
		</SectionContainer>

		<SectionContainer id='projects' class='pb-28'>
			<Projects />
		</SectionContainer>

		<SectionContainer id='about-me' class='pb-28'>
			<AboutMe />
		</SectionContainer>

		<SectionContainer id='contact' class='pb-28'>
			<Contact />
		</SectionContainer>
	</main>
</Layout>
