---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ReactIcon from "@/icons/React.astro";
import NextjsIcon from "@/icons/Nextjs.astro";
import NodejsIcon from "@/icons/Nodejs.astro";
import DockerIcon from "@/icons/Docker.astro";
import StrapiIcon from "@/icons/Strapi.astro";
import NestjsIcon from "@/icons/Nestjs.astro";
import MongoDBIcon from "@/icons/MongoDB.astro";
import MysqlIcon from "@/icons/Mysql.astro";
import AwsIcon from "@/icons/Aws.astro";
import ClaudeIcon from "@/icons/Claude.astro";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const STACK = [
	{ name: "React.js", icon: ReactIcon },
	{ name: "Node.js", icon: NodejsIcon },
	{ name: "Docker", icon: DockerIcon },
	{ name: "Nest.js", icon: NestjsIcon },
	{ name: "AWS", icon: AwsIcon },
	{ name: "Next.js", icon: NextjsIcon },
	{ name: "MongoDB", icon: MongoDBIcon },
	{ name: "MySQL", icon: MysqlIcon },
	{ name: "Claude Code", icon: ClaudeIcon },
	{ name: "Strapi", icon: StrapiIcon },
];
---

<SectionHeading title='Stack' subtitle={i18n.stack.subtitle} />
<ul class='stack-grid grid gap-3'>
	{
		STACK.map(({ name, icon: Icon }, index) => (
			<li>
				<div class='stack-badge' data-reveal={String((index % 5) + 1)}>
					<Icon class='size-[30px] shrink-0' />
					<span class='text-[17px] font-medium text-[var(--fg)]'>{name}</span>
				</div>
			</li>
		))
	}
</ul>

<style>
	.stack-grid {
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
	}
	@media (min-width: 1024px) {
		.stack-grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
	.stack-badge {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		height: 100%;
		box-sizing: border-box;
		border-radius: 1rem;
		border: 1px solid var(--border-1);
		background: var(--surface-3);
		padding: 1.25rem;
		transition:
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.3s ease,
			background 0.3s ease;
	}
	.stack-badge:hover {
		transform: translateY(-4px);
		border-color: oklch(0.82 0.14 195 / 0.4);
		background: var(--surface-2);
	}
</style>
