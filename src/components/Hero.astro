---
import Badge from "@/components/shared/Badge.astro";
import SocialPill from "@/components/shared/SocialPill.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import CVIcon from "@/icons/CV.astro";
import Mail from "@/icons/Mail.astro";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div id='hero-content'>
	<div class='flex items-center gap-4 mb-8 lg:mb-12 flex-wrap' data-reveal='1'>
		<div class='relative shrink-0'>
			<span
				class='absolute inset-0 rounded-full border-2 border-[var(--accent-cyan)] opacity-40 animate-ping'
			></span>
			<img
				src='/photo.webp'
				alt='Anthony photo'
				class='relative size-20 md:size-19 rounded-full object-cover object-center ring-2 ring-[var(--border-2)]'
			/>
		</div>
		<a
			href='https://www.linkedin.com/in/anthony-pastor/'
			target='_blank'
			rel='noopener'
			role='link'
			class='inline-flex transition hover:-translate-y-0.5'
		>
			<Badge>{i18n.home.available}</Badge>
		</a>
	</div>

	<h1
		class='font-bold text-[clamp(46px,8.5vw,104px)] leading-[0.96] tracking-[-0.04em] text-[var(--fg)] text-balance'
		data-reveal='2'
	>
		{i18n.home.greeting}{" "}
		<span
			class='bg-[linear-gradient(100deg,oklch(0.95_0.03_195),oklch(0.82_0.14_195)_45%,oklch(0.72_0.15_275))] bg-clip-text text-transparent'
		>
			Anthony
		</span>
	</h1>

	<p
		class='mt-8 max-w-[720px] text-[clamp(20px,2.6vw,28px)] leading-[1.45] text-[var(--text-2)] text-pretty'
		data-reveal='3'
	>
		<strong class='font-semibold text-[var(--fg)]'>{i18n.home.hero_strong}</strong>{" "}
		<span>{i18n.home.hero_rest}</span>
	</p>

	<nav class='flex gap-3 mt-10 flex-wrap' data-reveal='4'>
		<SocialPill link='mailto:npastordominguez@gmail.com' variant='primary'>
			<Mail class='size-4' />
			{i18n.home.cta_work}
		</SocialPill>
		<SocialPill link='/CV.pdf' downloadName='AnthonyPastor_CV.pdf' variant='ghost'>
			<CVIcon class='size-4' />
			{i18n.home.cta_cv}
		</SocialPill>
		<SocialPill
			link='https://www.linkedin.com/in/anthony-pastor/'
			variant='icon'
			ariaLabel='LinkedIn'
		>
			<LinkedIn class='size-5' />
		</SocialPill>
	</nav>
</div>
