---
import LenguageSwitcher from "@/components/header/LanguageSwitch.astro";
import { getI18N } from "@/i18n";
import { DEFAULT_LENGUAGE, LOCALES } from "@/i18n/locales.astro";

const navItems = [
	{ label: "home", target: "hero" },
	{ label: "experience", target: "experience" },
	{ label: "projects", target: "projects" },
	{ label: "about-me", target: "about-me" },
];

const { currentLocale = DEFAULT_LENGUAGE } = Astro;
const i18n = getI18N({ currentLocale });
const localeHref = LOCALES[currentLocale]?.href ?? "";
---

<header class='fixed top-2 lg:top-3.5 z-40 flex w-full items-center justify-center px-1.5 lg:px-4 box-border'>
	<nav class='nav-pill flex flex-wrap items-center justify-center gap-0.5 lg:gap-1 rounded-full p-1 lg:p-1.5'>
		{
			navItems.map((link) => (
				<a
					class='nav-link rounded-full px-2 py-1.5 text-[12px] lg:px-3.5 lg:py-2 lg:text-[15px] font-medium text-[var(--text-2)] transition whitespace-nowrap'
					aria-label={link.label}
					data-nav-target={link.target}
					href={`${localeHref}/#${link.target}`}
				>
					{/* @ts-expect-error */}
					{i18n.menu[link.label]}
				</a>
			))
		}
		<span class='block w-px h-4 lg:h-5 bg-[var(--border-2)] mx-0.5 lg:mx-1.5 shrink-0' aria-hidden='true'></span>
		<LenguageSwitcher />
	</nav>
</header>

<style>
	.nav-pill {
		border: 1px solid var(--border-2);
		background: oklch(0.16 0.01 260 / 0.6);
		backdrop-filter: blur(20px) saturate(1.4);
		box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.6);
	}
	.nav-link:hover:not(.is-active) {
		background: oklch(1 0 0 / 0.06);
	}
	.nav-link.is-active {
		background: var(--accent-cyan);
		color: var(--bg);
	}
</style>
