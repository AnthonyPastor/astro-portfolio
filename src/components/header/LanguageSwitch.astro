---
import { DEFAULT_LENGUAGE, LOCALES } from "@/i18n/locales.astro";

const { currentLocale = DEFAULT_LENGUAGE, url } = Astro;

const currentLocaleData = LOCALES[currentLocale];
const otherLocale = Object.values(LOCALES).find((locale) => locale.code !== currentLocale)!;
const currentPath = url.pathname.replace(currentLocaleData.href, "");
---

<a
	href={`${otherLocale.href}${currentPath}`}
	class='lang-toggle inline-flex items-center gap-1.5 lg:gap-[7px] rounded-full px-2 py-1.5 lg:px-3 lg:py-2 text-[12px] lg:text-[13px] text-[var(--text-2)] transition [font-family:var(--font-mono)] whitespace-nowrap'
	aria-label={`Switch to ${otherLocale.name}`}
>
	<currentLocaleData.flag class='size-[14px] lg:size-[17px] rounded-[2px] object-cover shrink-0' />
	<span>{currentLocaleData.code.toUpperCase()}</span>
</a>

<style>
	.lang-toggle:hover {
		background: oklch(1 0 0 / 0.06);
		color: #fff;
	}
</style>
