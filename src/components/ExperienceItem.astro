---
interface Props {
	variant: "current" | "past";
	date: string;
	title: string;
	companyAt: string;
	paragraph1: string;
	paragraph2: string;
	tags: string[];
	revealStep?: number;
}
const { variant, date, title, companyAt, paragraph1, paragraph2, tags, revealStep = 1 } =
	Astro.props;
const isCurrent = variant === "current";
const dotColor = isCurrent ? "var(--accent-cyan)" : "var(--accent-violet)";
const dotShadow = isCurrent
	? `0 0 0 5px oklch(0.85 0.13 195 / 0.15), 0 0 18px oklch(0.85 0.13 195 / 0.8)`
	: `0 0 0 5px oklch(0.72 0.15 275 / 0.15)`;
const companyColor = isCurrent ? "oklch(0.85 0.13 195)" : "oklch(0.8 0.13 275)";
const hoverBorder = isCurrent ? "oklch(0.85 0.13 195 / 0.3)" : "oklch(0.72 0.15 275 / 0.35)";
const tagClass = isCurrent
	? "text-[oklch(0.9_0.09_195)] bg-[oklch(0.82_0.14_195/0.1)] border-[oklch(0.82_0.14_195/0.25)]"
	: "text-[oklch(0.85_0.09_275)] bg-[oklch(0.72_0.15_275/0.12)] border-[oklch(0.72_0.15_275/0.25)]";
---

<li class='relative ms-6 mb-5' data-reveal={revealStep}>
	<span
		class='absolute -left-[1.85rem] top-6 size-3 rounded-full'
		style={`background:${dotColor}; box-shadow: ${dotShadow};`}
	>
	</span>
	<div class='exp-card' data-card style={`--hover-border: ${hoverBorder};`}>
		{
			isCurrent ? (
				<span class='inline-flex items-center gap-1.5 mb-3.5 rounded-full border border-[oklch(0.85_0.16_150/0.3)] bg-[oklch(0.85_0.16_150/0.14)] px-3 py-1 text-[12px] text-[oklch(0.9_0.13_150)] [font-family:var(--font-mono)]'>
					<span class='size-1.5 rounded-full bg-[var(--accent-green)]' />
					{date}
				</span>
			) : (
				<span class='inline-block mb-3.5 rounded-full border border-[var(--border-1)] bg-white/5 px-3 py-1 text-[12px] text-[var(--text-2)] [font-family:var(--font-mono)]'>
					{date}
				</span>
			)
		}
		<h3 class='text-[clamp(21px,2.4vw,26px)] font-semibold tracking-[-0.02em] leading-tight text-[var(--fg)] mb-1.5'>
			{title}
		</h3>
		<div class='text-[17px] mb-4' style={`color:${companyColor}`}>{companyAt}</div>
		<p class='text-[17px] leading-[1.6] text-[var(--text-1)] text-pretty' set:html={paragraph1} />
		<p class='mt-3 text-[17px] leading-[1.6] text-[var(--text-1)] text-pretty' set:html={paragraph2} />
		<ul class='mt-4 flex flex-wrap gap-2'>
			{
				tags.map((tag) => (
					<li class={`rounded-full border px-3 py-1 text-[12px] [font-family:var(--font-mono)] ${tagClass}`}>
						{tag}
					</li>
				))
			}
		</ul>
	</div>
</li>

<style>
	.exp-card {
		border-radius: 20px;
		border: 1px solid var(--border-1);
		background: var(--surface-2);
		backdrop-filter: blur(12px);
		padding: 26px 28px;
		transition:
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.3s ease;
	}
	.exp-card:hover,
	.exp-card.is-active {
		transform: translateX(6px);
		border-color: var(--hover-border);
	}
</style>
